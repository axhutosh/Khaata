# Copy to .env and adjust.
# SQLite by default (zero setup). For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/khaata
DATABASE_URL=sqlite:///./khaata.db
SECRET_KEY=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# Your single login (solo v1)
SEED_EMAIL=you@email.com
SEED_PASSWORD=password
