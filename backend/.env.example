# Copy to .env and adjust.
ENV=development                 # "production" refuses to start with unsafe defaults

# SQLite by default (zero setup). For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/khaata
DATABASE_URL=sqlite:///./khaata.db

# Signs the session cookie and upload-preview tokens. 32+ random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# The owner's Google account email (solo v1). Sign-in is Google only.
SEED_EMAIL=you@gmail.com

# Google sign-in (required: it's the only way in).
# Create an OAuth client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add http://localhost:5173
# under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Google accounts allowed in (comma-separated). Defaults to SEED_EMAIL.
ALLOWED_EMAILS=

SESSION_MAX_AGE=604800          # seconds a sign-in lasts (7 days)
# SESSION_SECURE=true           # cookie over HTTPS only; on by default in production
MAX_UPLOAD_MB=15
