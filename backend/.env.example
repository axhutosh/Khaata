# Copy to .env and adjust.
ENV=development                 # "production" refuses to start with unsafe defaults

# SQLite by default (zero setup). For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/khaata
DATABASE_URL=sqlite:///./khaata.db

# Signs the session cookie and upload-preview tokens. 32+ random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# Accounts: email + password. Anyone can create one (each gets their own separate Khaata).
# Set OPEN_SIGNUP=false to make new accounts invite-only: only ALLOWED_EMAILS (comma-separated).
OPEN_SIGNUP=true
ALLOWED_EMAILS=

# Encrypts stored bank narrations at rest. Required. BACK IT UP: lose it and they're unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put a new key first, keep the old after a comma, restart; then drop the old one.
DATA_KEY=

SESSION_MAX_AGE=604800          # seconds a sign-in lasts (7 days)
# SESSION_SECURE=true           # cookie over HTTPS only; on by default in production
MAX_UPLOAD_MB=15
